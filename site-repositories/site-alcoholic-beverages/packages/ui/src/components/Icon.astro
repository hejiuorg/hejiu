---
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 20, strokeWidth = 1.8, class: className = '' } = Astro.props;
---
<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'search' && <><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></>}
  {name === 'moon' && <path d="M20.5 14.4A8.5 8.5 0 0 1 9.6 3.5a8.5 8.5 0 1 0 10.9 10.9Z"></path>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></>}
  {name === 'system' && <><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.4 2.6 3.6 5.6 3.6 9S14.4 18.4 12 21c-2.4-2.6-3.6-5.6-3.6-9S9.6 5.6 12 3Z"></path></>}
  {name === 'bookmark' && <path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21l-6-3.8L6 21V4.5Z"></path>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16"></path>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18"></path>}
  {name === 'compass' && <><circle cx="12" cy="12" r="9"></circle><path d="m15.5 8.5-2.2 5.1-5.1 2.2 2.2-5.1 5.1-2.2Z"></path></>}
  {name === 'glass' && <><path d="M6 3h12l-1.2 17a2 2 0 0 1-2 1.9H9.2a2 2 0 0 1-2-1.9L6 3Z"></path><path d="M6.5 9h11"></path></>}
  {name === 'drop' && <path d="M12 3s6 6.2 6 11a6 6 0 0 1-12 0c0-4.8 6-11 6-11Z"></path>}
  {name === 'book' && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5v-13Z"></path><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20"></path></>}
  {name === 'map' && <><path d="m9 4 6 2 5-2v16l-5 2-6-2-5 2V6l5-2Z"></path><path d="M9 4v16M15 6v16"></path></>}
  {name === 'arrow-right' && <><path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path></>}
  {name === 'arrow-left' && <><path d="M19 12H5"></path><path d="m10 17-5-5 5-5"></path></>}
  {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7"></path>}
  {name === 'external' && <><path d="M14 4h6v6"></path><path d="M20 4 10 14"></path><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"></path></>}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6"></path>}
  {name === 'source' && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5v-13Z"></path><path d="M8 7h8M8 11h6"></path></>}
  {name === 'spark' && <><path d="m12 3 1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3Z"></path><path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"></path></>}
</svg>
