---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  title?: string;
}
const { size = 'md', class: className = '', title } = Astro.props;
const base = import.meta.env.BASE_URL;
const dimensions = { sm: 36, md: 64, lg: 180 } as const;
const dimension = dimensions[size];
const src = `${base}brand/${size === 'sm' ? 'd-mark.svg' : 'd-mascot.svg'}`;
---
<span class={`mascot mascot--${size} ${className}`} aria-hidden={title ? undefined : 'true'}>
  <img
    class="mascot__img"
    src={src}
    width={dimension}
    height={dimension}
    alt={title ?? ''}
    loading="eager"
    decoding="async"
  />
</span>
